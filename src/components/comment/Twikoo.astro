---
import { commentConfig } from "@/config/commentConfig";
import { url } from "@/utils/url-utils";

interface Props {
	path: string;
}

const twikooConfig = commentConfig.twikoo ?? { envId: "" };
const jsUrl =
	twikooConfig.jsUrl ||
	"https://registry.npmmirror.com/twikoo/1.7.15/files/dist/twikoo.min.js";
const cssUrl = twikooConfig.cssUrl;
const config = {
	...twikooConfig,
	el: "#tcomment",
	path: Astro.props.path,
};
---

<div id="tcomment"></div>
<script is:inline src={jsUrl}></script>
{cssUrl && <link rel="stylesheet" href={cssUrl.startsWith("http") ? cssUrl : url(cssUrl)} />}
<script is:inline define:vars={{ config }}>
  // 获取当前页面路径
  function getCurrentPath() {
    const requestedPath = new URLSearchParams(window.location.search).get("path");
    if (requestedPath) return requestedPath;
    const pathname = window.location.pathname;
    return pathname.endsWith("/") && pathname.length > 1
      ? pathname.slice(0, -1)
      : pathname;
  }

  // 动态创建配置对象
  function createTwikooConfig() {
    return {
      ...config,
      path: getCurrentPath(),
      el: "#tcomment",
    };
  }

  // Add a separate optional QQ field while reusing Twikoo's native QQ lookup.
  function mountQQInput() {
    const metaContainer = document.querySelector(
      "#twikoo .tk-submit .tk-meta-input",
    );

    if (!metaContainer || metaContainer.querySelector(".twikoo-qq-input")) {
      return;
    }

    const qqGroup = document.createElement("div");
    qqGroup.className =
      "el-input el-input--small el-input-group el-input-group--prepend twikoo-qq-input";
    qqGroup.innerHTML = `
      <div class="el-input-group__prepend">QQ</div>
      <input
        class="el-input__inner"
        type="text"
        inputmode="numeric"
        autocomplete="off"
        placeholder="Optional (for Avatar and Email)"
        aria-label="QQ number"
      />
    `;

    metaContainer.prepend(qqGroup);

    const qqInput = qqGroup.querySelector("input");
    qqInput?.addEventListener("change", () => {
      const qq = qqInput.value.trim();
      if (!qq) return;

      if (!/^[1-9]\d{4,11}$/.test(qq)) {
        qqInput.setCustomValidity("Please enter a valid QQ number.");
        qqInput.reportValidity();
        return;
      }

      qqInput.setCustomValidity("");

      const nickInput = metaContainer.querySelector('input[name="nick"]');
      if (!(nickInput instanceof HTMLInputElement)) return;

      nickInput.value = qq;
      nickInput.dispatchEvent(new Event("input", { bubbles: true }));
      nickInput.dispatchEvent(new Event("change", { bubbles: true }));
    });
  }

  // 初始化 Twikoo
  function initTwikoo() {
    if (typeof twikoo !== "undefined") {
      const commentEl = document.getElementById("tcomment");
      if (commentEl) {
        commentEl.innerHTML = "";

        const dynamicConfig = createTwikooConfig();
        console.log("[Twikoo] 初始化配置:", dynamicConfig);

        twikoo
          .init(dynamicConfig)
          .then(() => {
            console.log("[Twikoo] 初始化完成");
            mountQQInput();
          })
          .catch((error) => {
            console.error("[Twikoo] 初始化失败:", error);
          });
      }
    } else {
      // 如果 Twikoo 未加载，稍后重试
      setTimeout(initTwikoo, 500);
    }
  }

  // 页面加载时初始化
  document.addEventListener("DOMContentLoaded", initTwikoo);

  // Swup 页面切换后重新初始化
  if (window.swup && window.swup.hooks) {
    window.swup.hooks.on("content:replace", function () {
      setTimeout(initTwikoo, 200);
    });
  } else {
    document.addEventListener("swup:enable", function () {
      if (window.swup && window.swup.hooks) {
        window.swup.hooks.on("content:replace", function () {
          setTimeout(initTwikoo, 200);
        });
      }
    });
  }

  // 自定义事件监听
  document.addEventListener("firefly:page:loaded", function () {
    const commentEl = document.getElementById("tcomment");
    if (commentEl) {
      console.log("[Twikoo] 通过自定义事件重新初始化");
      initTwikoo();
    }
  });
</script>

<style is:global>
  #twikoo .tk-meta-input {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  #twikoo .tk-meta-input .el-input {
    width: 100%;
    margin: 0;
  }

  #twikoo .tk-meta-input .el-input + .el-input {
    margin-left: 0;
  }

  @media (max-width: 767px) {
    #twikoo .tk-meta-input {
      grid-template-columns: 1fr;
    }

    #twikoo .tk-meta-input .el-input + .el-input {
      margin-top: 0;
    }
  }
</style>
